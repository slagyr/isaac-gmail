{:id          :isaac.comm.gmail
 :version     "0.2.3"
 :builtin?    true
 :factory     isaac.comm.gmail.module/create-module
 :description "Gmail comm for Isaac — watch on INBOX, history walk, thread-as-session routing; replies on thread. Built on isaac-google."

 :isaac.agent/comm
 {:gmail {:namespace    isaac.comm.gmail
          :extra-schema {:gmail/google             {:type        :keyword
                                                     :description "Google organization (tenant) this comm speaks for: it sends with that organization's token and its mailbox is watched against that organization's topic. Omit on a host with one organization."}
                         :gmail/account            {:type        :string
                                                     :description "Google account email of the Isaac user."}
                         :gmail/allow-from         {:type        :ignore
                                                     :validations [[:retired? "use gmail-routes — a :converse route names :match :from"]]}
                         :gmail/crew               {:type        :string
                                                     :description "Default crew for a route with no :crew of its own, or for every message when no gmail-routes are configured at all."}
                         :gmail/label-prefix       {:type        :string
                                                     :description "Prefix for verdict labels (isaac/<route>, isaac/ignored, isaac/unrouted). Default \"isaac\"."}
                         :gmail/ignore-categories  {:type        :seq
                                                     :spec        {:type :string}
                                                     :description "Gmail category labels that gate a message to :ignore before any route runs. Default CATEGORY_PROMOTIONS, CATEGORY_SOCIAL, CATEGORY_UPDATES, CATEGORY_FORUMS."}
                         :gmail/ignore-marks-read  {:type        :boolean
                                                     :description "Remove Gmail's UNREAD label from a message an :ignore route (or the gate) drops. Default true."}
                         :gmail/task-body-cap      {:type        :int
                                                     :description "Character cap on a :task route's body-excerpt param. Default 4000. The full message stays readable through the gmail__read tool by id (isaac-3427)."}
                         :gmail/mode               {:type        :keyword
                                                     :validations [[:one-of :push :pull]]
                                                     :description "How this comm learns about new INBOX mail: :push (default) registers a Pub/Sub watch; :pull schedules an interval task that walks history from the stored cursor instead — no watch, no topic, no door (isaac-u80t)."}
                         :gmail/pull-interval-ms   {:type        :long
                                                     :description "How often the :gmail/pull scheduler task walks history in gmail/mode :pull. Default 60000 (isaac-u80t)."}}}}

 ;; Mailbox tools on Isaac's own token and the crew's allow-list (isaac-jqk2).
 :isaac.agent/tools
 {:gmail__search {:factory isaac.comm.gmail.tools/search-tool-factory}
  :gmail__read   {:factory isaac.comm.gmail.tools/read-tool-factory}
  :gmail__send   {:factory isaac.comm.gmail.tools/send-tool-factory}
  :gmail__labels {:factory isaac.comm.gmail.tools/labels-tool-factory}}

 :isaac.google/handler
 {"gmail/watch" isaac.comm.gmail.handler/handle-watch!}

 :isaac.google/scopes
 ["https://www.googleapis.com/auth/gmail.modify"
  "https://www.googleapis.com/auth/gmail.send"]

 :isaac.google/registration
 {:gmail-watch {:create! isaac.comm.gmail.watch/watch!
                :renew!  isaac.comm.gmail.watch/watch!
                :expiry  isaac.comm.gmail.watch/expiry
                :key     isaac.comm.gmail.watch/keys*
                :remote  isaac.comm.gmail.watch/remote
                :delete! isaac.comm.gmail.watch/stop!}}

 :isaac.config/schema
 {:gmail-routes
  {:schema
   {:name        :gmail-routes
    :type        :map
    :snapshot-only? true
    :description "Named Gmail routing rules (map of route name -> route), ordered by :order ascending (ties by name — a map carries no order of its own). One .edn file per route under config/gmail-routes/, or inline. First match wins; a message no route claims is :unrouted. Routes are the whitelist: a :converse or :task route must name :match :from (isaac-sb6d, isaac-3427)."
    :key-spec    {:type :string}
    :value-spec
    {:name   :gmail-route
     :type   :map
     :schema {:order   {:type        :int
                        :description "Match precedence, ascending; ties broken by route name."}
              :match   {:type        :map
                        :description "Every given key must match (AND); a missing key matches anything. :to/:from are globs (* only, case-insensitive); a *@domain :from is honoured only when Gmail authenticates the sender's domain. :subject is a regex string. :label names a Gmail label the message must carry. :list-id compares the List-Id header exactly."
                        :schema {:to      {:type :string}
                                 :from    {:type :string}
                                 :subject {:type :string}
                                 :label   {:type :string}
                                 :list-id {:type :string}}}
              :action  {:type        :keyword
                        :description "How a matched message is handled: :converse, :ignore, or :task (send a hail instead of starting a thread session). An unknown action is a config-validate error naming the route."}
              :crew    {:type        :string
                        :description "Crew for a :converse route; default gmail/crew."}
              :comm    {:type        :keyword
                        :description "Restrict this route to one Gmail comm when several tenants run."}
              :desc    {:type        :string
                        :description "Shown to the triage model fallback (isaac-betb)."}
              :band    {:type        :string
                        :description "Hail band for a :task route; required (isaac-3427)."}
              :ack     {:type        :boolean
                        :description "A :task route replies once on the thread (\"Got it — filed as ...\") when true. Default false — no reply (isaac-3427)."}
              :params  {:type        :map
                        :description "Extra hail :params for a :task route, merged under the mail payload — gmail/id, gmail/thread-id, from, subject, body-excerpt win on a key collision (isaac-3427)."}}}}}

   :gmail/triage
   {:schema
    {:name        :gmail-triage
     :type        :map
     :snapshot-only? true
     :description "Triage fallback for unrouted Gmail mail (isaac-betb): when :model is set, a message routes/decide reports :unrouted (and not auth-blocked) runs one turn in a dedicated, reset-context session instead of going straight to :unrouted. The model picks one of :choices or \"ignore\"; anything else falls back to :default. The verdict is always recorded as label isaac/triage/<verdict>. With :apply true the message is then dispatched as if its verdict route had matched, so that route's own label lands too. It never overrides a route routes/decide already matched."
     :schema
     {:model   {:type :string :description "Model alias for the one-off triage turn."}
      :crew    {:type :string :description "Crew id whose config (aside from :tools, replaced with deny-all for this call) resolves the triage turn. Default \"main\"."}
      :choices {:type :seq :spec {:type :string} :description "Route names the model may answer with, plus the literal \"ignore\"."}
      :default {:type :string :description "Verdict used when the model's answer is neither \"ignore\" nor one of :choices. Default \"ignore\"."}
      :apply   {:type :boolean :description "Redispatch the message through the matched route's own action when true. Default false — audit-only."}}}}}

 :isaac.config/check
 {:gmail-routes {:fn isaac.comm.gmail.routes/check-config}}
}
